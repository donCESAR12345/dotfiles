[Unit]
Description=Bidirectional synchronization with Google Drive using Rclone 
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/rclone bisync %h/Cloud/GoogleDrive gdrive:/ --filter-from %h/.config/rclone/filters.txt --bwlimit 2M --resilient --fix-case
CPUSchedulingPolicy=idle
IOSchedulingClass=idle

[Install]
WantedBy=default.target
