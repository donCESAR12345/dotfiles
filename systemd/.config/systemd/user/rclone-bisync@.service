[Unit]
Description=Bidirectional sync via Rclone (%i)
After=network-online.target
Wants=network-online.target
OnFailure=notify-rclone-bisync-failed@%i.service

[Service]
Type=oneshot
Environment="FILTER_FILE=%h/.config/rclone/filters.txt"
EnvironmentFile=%h/.config/rclone/sync-%i.env
ExecStart=/usr/bin/rclone bisync \
    ${LOCAL_PATH} \
    ${REMOTE_PATH} \
    --bwlimit ${BWLIMIT} \
    --filter-from ${FILTER_FILE} \
    --compare modtime,size \
    --conflict-resolve newer \
    --max-delete 90 \
    --resilient \
    --recover \
    --max-lock 1h \
    --drive-export-formats link.html \
    --fix-case \
    --log-file ${LOG_FILE} \
    --log-level NOTICE
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
KillSignal=SIGINT
TimeoutStopSec=15s

[Install]
WantedBy=default.target
