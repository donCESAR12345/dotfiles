import json\
\
# Load notebook\
with open('01_ProbabilisticFeatures.ipynb', 'r') as f:\
    nb = json.load(f)\
\
# Find and fix the docstring\
for i, cell in enumerate(nb['cells']):\
    if cell['cell_type'] == 'code':\
        source = ''.join(cell['source'])\
        if 'get_adaptive_features' in source and '"""' in source:\
            print(f"Updating docstring in cell {i}")\
            # Update the docstring to reflect that features include range\
            new_source = ''.join(cell['source']).replace(\
                '(features, num_peaks_found, refinement_attempts)\n        - features: shape (8,)',\
                '(features, num_peaks_found, refinement_attempts)\n        - features: shape (8,) with [range, peak_locations, valley_locations]'\
            )\
            cell['source'] = new_source.split('\n')[:-1] if new_source.endswith('\n') else new_source.split('\n')\
            cell['source'] = [line + '\n' for line in cell['source'][:-1]] + [cell['source'][-1]]\
            break\
\
# Save updated notebook\
with open('01_ProbabilisticFeatures.ipynb', 'w') as f:\
    json.dump(nb, f, indent=1)\
\
print("Docstring updated successfully")\
EOF
