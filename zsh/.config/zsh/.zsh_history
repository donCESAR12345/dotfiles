cd /home/cesar/Cloud/OneDrive/UdeA/Semestre/Pr√ÉÅctica\ acad√©mica/Trabajo\ de\ grado/osnr-and-spectral-overlapping-estimation-mogp-3x32gbaud && python3 << 'EOF'\
import json\
\
# Load notebook\
with open('01_ProbabilisticFeatures.ipynb', 'r') as f:\
    nb = json.load(f)\
\
# Find and fix the cell that contains the feature extraction return statement\
for i, cell in enumerate(nb['cells']):\
    if cell['cell_type'] == 'code':\
        source = ''.join(cell['source'])\
        if 'features = np.concatenate(([current_bw]' in source:\
            print(f"Found target in cell {i}")\
            # Replace the line\
            cell['source'] = [line.replace(\
                'features = np.concatenate(([current_bw], padded_peaks, padded_valleys))',\
                '# Range represents the spread of the KDE distribution and correlates with signal quality\n    data_range = np.max(data) - np.min(data)\n    features = np.concatenate(([data_range], padded_peaks, padded_valleys))'\
            ).replace(\
                '# Features: [bandwidth, peaks (4), valleys (3)] -> Size 8',\
                '# Features: [range, peaks (4), valleys (3)] -> Size 8'\
            ) for line in cell['source']]\
            break\
\
# Save updated notebook\
with open('01_ProbabilisticFeatures.ipynb', 'w') as f:\
    json.dump(nb, f, indent=1)\
\
print("Notebook updated successfully")\
EOF
