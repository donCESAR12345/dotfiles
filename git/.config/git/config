[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3

[init]
	defaultBranch = main

[pull]
	rebase = true

[fetch]
	prune = true

[rerere]
	enabled = true

[gpg]
	format = ssh

# Enable commit signing in ~/.config/git/config.local once user.signingkey is set:
# [user]
# 	signingkey = ~/.ssh/id_ed25519.pub
# [commit]
# 	gpgsign = true

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Local overrides and sensitive settings (e.g. [user] signingkey, [sendemail])
[include]
	path = ~/.config/git/config.local
